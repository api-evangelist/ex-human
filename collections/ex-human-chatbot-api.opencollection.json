      "items": [
        {
          "info": {
            "name": "Get Multimodal Chat Response",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exh.ai/chatbot/v3/response",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Multimodal chat response endpoint.\n\nIt can be used to support engaging conversations with both text and image responses.\n\nFor usage examples, see: https://docs.exh.ai/recipes/multimodal-chat"
        },
        {
          "info": {
            "name": "Get Smart Replies",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.exh.ai/chatbot/v2/get_smart_replies",
            "headers": [
              {
                "name": "X-Request-Id",
                "value": ""
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Smart reply endpoint.\n\nUse it to get possible user responses for the current dialog context. They can be served as a\n help for the user on how to continue the conversation."
        },
        {
          "info": {
            "name": "Clear Long-Term Memory",
